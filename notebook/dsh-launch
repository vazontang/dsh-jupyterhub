#!/usr/bin/env python3
"""Start `dsh web` for jupyter-server-proxy.

Called as:  dsh-launch {port} {base_url}
- Generates a --patch overlay from the env injected by the Hub, so the AI key
  never lands on disk (DSH resolves apiKeyEnv from the process env).
- Captures the one-time launch URL that `dsh web` prints and stores it (0600)
  in /tmp/dsh-$UID/launch-url (container-local) for the /dsh-open handler.
- Hub env: DSH_PUBLIC_HOST, DSH_LLM_MODE (deepseek|custom), DSH_LLM_MODEL,
  DEEPSEEK_API_KEY or DSH_LLM_API_KEY/_PROVIDER/_API/_BASE_URL.
"""
import json, os, re, signal, subprocess, sys
from pathlib import Path

port, base_url = sys.argv[1], sys.argv[2]
if not base_url.endswith("/"):
    base_url += "/"
home = Path.home()
dsh_home = Path(os.environ.get("DSH_HOME", home / ".dsh"))
public_host = os.environ["DSH_PUBLIC_HOST"]
public_scheme = os.environ.get("DSH_PUBLIC_SCHEME", "https")

# 1. generate the Hub-managed patch overlay (no secrets: keys are referenced by
#    env name and resolved by DSH at request time). The user's own
#    ~/.dsh/profiles/web/cordis.patch.yml is left untouched.
def q(v):  # YAML-safe scalar (JSON string is valid YAML)
    return json.dumps(v)

mode = os.environ.get("DSH_LLM_MODE", "deepseek")  # deepseek | custom
model = os.environ.get("DSH_LLM_MODEL", "deepseek-flash")
lines = []
if mode == "custom":
    provider = os.environ.get("DSH_LLM_PROVIDER", "gateway")
    lines += [
        "- id: llm-pi-ai",
        "  config:",
        "    providers:",
        f"      {q(provider)}:",
        "        apiKeyEnv: DSH_LLM_API_KEY",
        f"        api: {q(os.environ.get('DSH_LLM_API', 'openai-completions'))}",
        f"        baseURL: {q(os.environ['DSH_LLM_BASE_URL'])}",
        "        models:",
        f"          - id: {q(model)}",
    ]
else:
    provider = "deepseek-official"  # built-in route, reads DEEPSEEK_API_KEY
lines += [
    "- id: agent-default-model",
    "  config:",
    f"    provider: {q(provider)}",
    f"    model: {q(model)}",
]
if os.environ.get("JUPYTERHUB_API_TOKEN") or os.environ.get("DSH_JUPYTER_TOKEN"):
    jupyter_port = os.environ.get("DSH_JUPYTER_PORT", "8888")
    lines += [
        "- insert:",
        "    - id: mcp-jupyter",
        "      name: '@deepseek-ai/dsh-mcp-client'",
        "      config:",
        "        serverName: jupyter",
        "        transport: streamable-http",
        f"        url: {q(f'http://127.0.0.1:{jupyter_port}{base_url}mcp')}",
        "        toolCallTimeoutMs: 600000",
        "        headers:",
        "          Authorization: !!js \"`token ${process.env.DSH_JUPYTER_TOKEN ?? process.env.JUPYTERHUB_API_TOKEN}`\"",
    ]

# runtime state is container-local (not on the home volume); must match dsh_open.py
state = Path(os.environ.get("DSH_RUNTIME_DIR", f"/tmp/dsh-{os.getuid()}"))
state.mkdir(mode=0o700, parents=True, exist_ok=True)
os.chmod(state, 0o700)
launch_file = state / "launch-url"
launch_file.unlink(missing_ok=True)
hub_patch = state / "hub.patch.yml"
hub_patch.write_text("# generated by dsh-launch from Hub settings; do not edit\n" + "\n".join(lines) + "\n")
# never keep a credentials file on the home volume
(dsh_home / ".credentials.yaml").unlink(missing_ok=True)

cmd = [
    os.environ.get("DSH_BIN", "dsh"), "--profile", "web", "--patch", str(hub_patch),
    "--no-open", "--host", "127.0.0.1", "--port", port,
    "--public-url", f"{public_scheme}://{public_host}{base_url}dsh/",
    "--trusted-host", public_host,
]
extra = os.environ.get("DSH_EXTRA_ARGS")
if extra:
    cmd += extra.split()

proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=None, text=True, bufsize=1,
                        cwd=os.environ.get("DSH_WORKDIR", str(home)))
for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
    signal.signal(sig, lambda s, f: proc.send_signal(s))

token_re = re.compile(r"(?<=[?&]token=)([A-Za-z0-9_\-]+)")
for line in proc.stdout:
    m = token_re.search(line)
    if m and not launch_file.exists():
        fd = os.open(launch_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(m.group(1))
        line = token_re.sub("<redacted>", line)
    sys.stdout.write(line)
    sys.stdout.flush()
sys.exit(proc.wait())
